.ralph/logs/

# Ralph loop runtime state — regenerated on every run, no value in history
.ralph/.*
.ralph/live.log
.ralph/progress.json
.ralph/status.json
bmalph/state/

# Byte-compiled files are build output, never source.
__pycache__/
*.pyc

# Transient analysis scratch files, written and discarded during a run.
.response_analyzer.*
