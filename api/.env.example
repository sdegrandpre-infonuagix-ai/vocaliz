# Database (Aurora Serverless v2 PostgreSQL)
DATABASE_URL=postgresql://salon:password@localhost:5432/salon

# JWT
JWT_SECRET=change-me-in-production-use-secrets-manager
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# AWS
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS SNS (OTP SMS)
SNS_SENDER_ID=Salon

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Local development only — log the OTP to the API console instead of sending SMS.
# Leave false (or unset) anywhere real users can reach the API.
DEV_MODE=false

# LiveKit (for token provisioning)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
