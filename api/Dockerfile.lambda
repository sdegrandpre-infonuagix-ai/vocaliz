# API image for AWS Lambda (container image deployment).
#
# A container image is used rather than a zip bundle because psycopg2-binary needs
# manylinux wheels that cannot be produced on a Windows dev machine — building inside
# the Lambda base image sidesteps cross-platform packaging entirely.
FROM public.ecr.aws/lambda/python:3.12

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /bin/uv

WORKDIR ${LAMBDA_TASK_ROOT}

# Dependencies first so edits to src/ do not invalidate the layer.
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --format requirements-txt > /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt -t "${LAMBDA_TASK_ROOT}"

COPY src/ ./src/
COPY migrations/ ./migrations/
COPY alembic.ini ./
# guest_web serves web/join.html via FileResponse; without this the anonymous
# browser join route 500s on Lambda while working fine locally.
COPY web/ ./web/

# Overridden by the migration function, which runs `alembic upgrade head` instead.
CMD ["src.main.handler"]
