{
  "expo": {
    "name": "Salon",
    "slug": "salon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "salon",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.infonuagix.salon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Salon needs microphone access for voice conversations.",
        "NSCameraUsageDescription": "Salon may use the camera for future features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.infonuagix.salon",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F3E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ],
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "Vocaliz uses your contacts so you can invite someone without typing their address."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:8000",
      "livekitUrl": "",
      "eas": {
        "projectId": "e1bd88f7-b3af-467b-afe1-e2f0a0025d52"
      }
    },
    "owner": "infonuagix-ai"
  }
}
