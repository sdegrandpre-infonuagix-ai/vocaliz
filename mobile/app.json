{
  "expo": {
    "name": "Vocaliz",
    "slug": "salon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vocaliz",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.infonuagix.vocaliz",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Vocaliz needs microphone access for voice conversations.",
        "NSCameraUsageDescription": "Vocaliz may use the camera for future features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.infonuagix.vocaliz",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_CONTACTS",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F3E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ],
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "Vocaliz uses your contacts so you can invite someone without typing their address."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#7B1528",
          "resizeMode": "contain",
          "imageWidth": 260
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:8000",
      "livekitUrl": "",
      "eas": {
        "projectId": "e1bd88f7-b3af-467b-afe1-e2f0a0025d52"
      }
    },
    "owner": "infonuagix-ai",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e1bd88f7-b3af-467b-afe1-e2f0a0025d52"
    }
  }
}
