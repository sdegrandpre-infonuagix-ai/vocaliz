{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The test files import `./x.ts` explicitly because that is what Node's type stripping
    // resolves — `npm test` runs them with no bundler and no build step.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.d.ts"]
}
