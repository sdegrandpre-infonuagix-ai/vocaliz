# Local orchestrator configuration.
#
# Copy to .env and adjust. Everything here works against local processes: starting the
# orchestrator on a laptop must not require an AWS account, a LiveKit subscription or any
# paid provider — the stories that follow have to be developable offline.
#
# In AWS none of this is set by hand: the ECS task passes ORCHESTRATOR_SECRET_ARN and the
# service reads the values from Secrets Manager at startup.

# LiveKit — `livekit-server --dev` listens here and accepts the devkey/secret pair below.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The journal and the interpreter positions of Story 6.3 live here. Unused by Story 6.1,
# and required all the same: a service that starts without its storage would only discover
# the mistake when somebody opens a Salon.
DATABASE_URL=postgresql://salon:password@localhost:5432/salon

# Service
PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=local
AWS_REGION=ca-central-1
