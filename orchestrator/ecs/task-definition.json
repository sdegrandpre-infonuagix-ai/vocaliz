{
  "family": "salon-orchestrator",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/salon-orchestrator-execution",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/salon-orchestrator-task",
  "containerDefinitions": [
    {
      "name": "orchestrator",
      "image": "${ECR_REPOSITORY_URI}:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ca-central-1"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "ORCHESTRATOR_SECRET_ARN",
          "value": "arn:aws:secretsmanager:ca-central-1:${AWS_ACCOUNT_ID}:secret:salon/orchestrator"
        },
        {
          "name": "PORT",
          "value": "8080"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "stopTimeout": 120,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/salon-orchestrator",
          "awslogs-region": "ca-central-1",
          "awslogs-stream-prefix": "orchestrator",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
